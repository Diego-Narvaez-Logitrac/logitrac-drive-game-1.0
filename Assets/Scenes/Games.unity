--- !u!114 &1238493741
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1238493740}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3ba6b7b14b9464ec384ecc15c8b81533, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LogitracDrive.Runtime::LogitracDrive.GamesApp
  games:
  - id: convoy-rush
    title: Convoy Rush
    tagline: "Collect cars, grow your convoy, and don\u2019t crash into your own
      tail."
    cardMeta: "Drag to steer \xB7 30\u201390 s rounds"
    description: Drive around the arena and pick up cars to grow your convoy. The
      longer it gets, the harder it is to steer without hitting walls, traffic or
      your own tail.
    roundLength: "30\u201390 s rounds"
    mode: Endless
    controls: Drag to steer
    howToPlay:
    - Drag anywhere to steer your lead car.
    - Drive into glowing cars to add them to your convoy.
    - 'Avoid walls, traffic and your own convoy. Score: cars collected + time survived.'
    comingSoonMessage: Convoy Rush gameplay is in development. This button will start
      a run.
    artworkFile: Blue Hour Convoy Rush
    artwork: {fileID: 21300000, guid: bddd076c938be4081a3b6521343c28ea, type: 3}
  - id: highway-blitz
    title: Highway Blitz
    tagline: Weave through highway traffic at full speed. Near misses score big.
    cardMeta: "Swipe lanes \xB7 45\u2013120 s rounds"
    description: Race down a three-lane highway as traffic gets faster and denser.
      Dodge cars, chain near misses and push your distance.
    roundLength: "45\u2013120 s rounds"
    mode: Endless
    controls: Swipe lanes
    howToPlay:
    - Swipe left or right to change lanes.
    - Pass close to cars for near-miss bonuses and combos.
    - 'One crash ends the run. Score: distance + near-miss bonus.'
    comingSoonMessage: Highway Blitz gameplay is in development. This button will
      start a run.
    artworkFile: Logitrac midnight highway blitz-3
    artwork: {fileID: 21300000, guid: 27245993a9a2f4b17b90ea1e154c9000, type: 3}
  - id: precision-garage
    title: Precision Garage
    tagline: Draw the perfect path and park without touching a single cone.
    cardMeta: "Draw a path \xB7 3-star levels"
    description: Guide each vehicle into its marked space without touching cones,
      walls or other cars. Clean, quick parking earns three stars.
    roundLength: "20\u201390 s levels"
    mode: "Levels \xB7 1\u20133 stars"
    controls: Draw a path
    howToPlay:
    - Draw a path from your car to the glowing space.
    - Lift your finger and the car follows your path.
    - No contact and a fast finish earn all three stars.
    comingSoonMessage: Precision Garage gameplay is in development. This button will
      start the first level.
    artworkFile: Silver Logitrac Van in Precision Garage-1
    artwork: {fileID: 21300000, guid: 102fd890f49a14d16acd666a28210805, type: 3}
  - id: turbo-circuit
    title: Turbo Circuit
    tagline: Race mini cars on tight tracks. Drift the corners to fill your boost.
    cardMeta: "Hold to steer \xB7 60\u2013180 s races"
    description: Race compact cars around tight tracks against rivals and the clock.
      Drift through corners to charge your boost.
    roundLength: "60\u2013180 s races"
    mode: "Vs rivals \xB7 lap time"
    controls: Hold to steer
    howToPlay:
    - Your car accelerates on its own.
    - Hold the left or right side of the screen to steer.
    - Hold both sides to drift and fill your boost.
    comingSoonMessage: Turbo Circuit gameplay is in development. This button will
      start a race.
    artworkFile: Logitrac GTs Charge Through the Apex-2
    artwork: {fileID: 21300000, guid: 11a2951307b09495d924ba12bfc7ec6b, type: 3}
  bodyFont: {fileID: 0}
  displayFont: {fileID: 0}
